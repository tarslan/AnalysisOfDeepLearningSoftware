# Preserve protocol and compact experiment records; generated artifacts stay ignored.
!docs/experiment_manifest.template.json
!Dissertation/experiments/
!Dissertation/experiments/**/manifest.json
!Dissertation/experiments/**/manifest.sha256
!Dissertation/experiments/**/checksums.sha256
!Dissertation/experiments/**/derived/
!Dissertation/experiments/**/derived/*.md

# Source articles and example dissertation files are kept outside version control.
/Dissertation/Articles/
/Dissertation/Example-Dissertation/

# LaTeX build outputs; keep source files, bibliography, and diagram PNGs tracked.
/Dissertation/latex/**/*.aux
/Dissertation/latex/**/*.bbl
/Dissertation/latex/**/*.bcf
/Dissertation/latex/**/*.blg
/Dissertation/latex/**/*.fdb_latexmk
/Dissertation/latex/**/*.fls
/Dissertation/latex/**/*.out
/Dissertation/latex/**/*.pdf
/Dissertation/latex/**/*.run.xml
/Dissertation/latex/**/*.synctex.gz
/Dissertation/latex/**/*.toc
/Dissertation/latex/**/*.xdv
